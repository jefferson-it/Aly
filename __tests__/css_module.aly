// CSS Module Test

css.create("main")

css.addRule("main", ".btn", '{"background": "primary", "color": "white", "padding": "md", "border-radius": "lg", "font-weight": "medium", "transition": "normal"}', "", "")

css.addRule("main", ".btn:hover", '{"background": "primary-hover", "transform": "translateY(-2px)", "box-shadow": "glow"}', "", "")

css.addRule("main", ".card", '{"background": "surface", "border": "1px solid var(--border)", "border-radius": "xl", "padding": "lg", "box-shadow": "md"}', "", "")

css.addRule("main", ".container", '{"max-width": "1200px", "margin": "0 auto", "padding": "xl"}', "", "")

css.addKeyframes("main", "fadeIn", '{"0%": {"opacity": "0", "transform": "translateY(10px)"}, "100%": {"opacity": "1", "transform": "translateY(0)"}}')

css.addKeyframes("main", "slideIn", '{"0%": {"opacity": "0", "transform": "translateX(-20px)"}, "100%": {"opacity": "1", "transform": "translateX(0)"}}')

css.themeCreate("dark", 
  '{"primary": "#6366f1", "primary-hover": "#4f46e5", "secondary": "#a855f7", "success": "#22c55e", "warning": "#f59e0b", "danger": "#ef4444", "background": "#0f0f13", "surface": "#191923", "text": "#f1f1f7", "text-muted": "#a1a1aa", "border": "rgba(255, 255, 255, 0.08)"}',
  '{"xs": "4px", "sm": "8px", "md": "16px", "lg": "24px", "xl": "32px", "2xl": "48px"}',
  '{"font-family": "\"Outfit\", -apple-system, sans-serif", "font-size-xs": "12px", "font-size-sm": "14px", "font-size-base": "16px", "font-size-lg": "18px", "font-size-xl": "24px", "font-size-2xl": "32px", "font-weight-normal": "400", "font-weight-medium": "500", "font-weight-bold": "600"}',
  '{"sm": "640px", "md": "768px", "lg": "1024px", "xl": "1280px", "2xl": "1536px"}',
  '{"sm": "0 1px 2px 0 rgba(0, 0, 0, 0.05)", "md": "0 4px 6px -1px rgba(0, 0, 0, 0.1)", "lg": "0 10px 15px -3px rgba(0, 0, 0, 0.1)", "xl": "0 20px 25px -5px rgba(0, 0, 0, 0.1)", "glow": "0 0 20px rgba(99, 102, 241, 0.3)"}',
  '{"none": "0", "sm": "4px", "md": "8px", "lg": "12px", "xl": "16px", "full": "9999px"}',
  '{"fast": "150ms ease", "normal": "200ms ease", "slow": "300ms ease"}'
)

css.themeSet("dark")

let cssOutput = css.render("main", "dark")
console.log("Generated CSS:")
console.log(cssOutput)

let minified = css.minify(cssOutput)
console.log("\nMinified CSS:")
console.log(minified)

let critical = css.extractCritical('<div class="btn">Click</div><div class="card">Content</div>')
console.log("\nCritical CSS:")
console.log(critical)

let scoped = css.scope("main", "component")
console.log("\nScoped class:", scoped)