// WebAssembly Backend Test

// Test WASM compilation
let source = `
fun add(a, b) {
  return a + b
}

fun fibonacci(n) {
  if (n <= 1) return n
  return fibonacci(n - 1) + fibonacci(n - 2)
}

fun main() {
  let result = add(10, 20)
  let fib = fibonacci(10)
  return result
}
`

let wat = wasm.compile(source, "test-module")
console.log("WAT Output:")
console.log(wat)

// Compile from file
wasm.compileFile("test.aly", "test.wat")

// Instantiate and call
wasm.instantiate("test.wasm", '{"env": {"memory": {}, "table": {}}}')

// Call function
wasm.call("test-instance", "add", "[10, 20]")

console.log("WASM backend test completed!")